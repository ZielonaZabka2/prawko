# OSK Artur Żyliński – konfiguracja serwera (Apache / LiteSpeed, LH.pl)
Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
RewriteEngine On

# --- HTTPS: odkomentuj 2 linie poniżej PO włączeniu certyfikatu SSL w panelu LH.pl ---
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- bez www (oskszkolabezpiecznejjazdy.lomza.pl) ---
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ %{REQUEST_SCHEME}://%1%{REQUEST_URI} [L,R=301]

# --- katalogi z kodem i danymi niedostępne z przeglądarki ---
RewriteRule ^(app|data)(/|$) - [F,L]
RewriteRule (^|/)\. - [F,L]

# --- stare adresy WordPressa → strona główna ---
RewriteRule ^(wp-admin|wp-login\.php|wp-content|wp-includes|xmlrpc\.php) / [R=301,L]

# --- wszystko inne, czego nie ma jako plik, obsługuje index.php ---
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
<FilesMatch "\.(webp|jpg|jpeg|png|svg|ico|woff2|css|js)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<FilesMatch "\.(json|md|log|tmp|bak)$">
Require all denied
</FilesMatch>
